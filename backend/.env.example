NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Set TRUST_PROXY to a trusted proxy hop count only when a reverse proxy is in front of the API.
# Keep false for direct local development; forwarded headers are not trusted by default.
TRUST_PROXY=false
API_PREFIX=api/v1
FRONTEND_ORIGIN=http://127.0.0.1:3100

# Replace these placeholders privately. The safe portfolio launcher accepts only this isolated target.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5433/altura_dev?schema=public

# Development placeholders are accepted only outside production. Use unique random values in deployments.
JWT_ACCESS_SECRET=change-this-access-secret-before-real-use
JWT_REFRESH_SECRET=change-this-refresh-secret-before-real-use
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GUEST_SESSION_TTL=90d

DEFAULT_CURRENCY=EGP
DEFAULT_COUNTRY=EG
FREE_SHIPPING_THRESHOLD=1500
DEFAULT_TAX_RATE=0
CHECKOUT_RESERVATION_TTL=30m
STANDARD_SHIPPING_PRICE=12
EXPRESS_SHIPPING_PRICE=24

# Bounded in-memory abuse controls. These are per-process and should be paired
# with edge controls for multi-instance production deployments.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW_MS=300000
RATE_LIMIT_REGISTER_LIMIT=3
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REFRESH_LIMIT=20
RATE_LIMIT_REFRESH_WINDOW_MS=600000
RATE_LIMIT_GUEST_LOOKUP_LIMIT=5
RATE_LIMIT_GUEST_LOOKUP_WINDOW_MS=300000
RATE_LIMIT_PAYMENT_INIT_LIMIT=20
RATE_LIMIT_PAYMENT_INIT_WINDOW_MS=600000
RATE_LIMIT_MOCK_COMPLETE_LIMIT=10
RATE_LIMIT_MOCK_COMPLETE_WINDOW_MS=600000

# Local portfolio profile uses mock in backend development mode only.
# Production rejects known JWT placeholders; mock completion/refund is blocked in production.
# Do not configure real provider credentials for local testing.
PAYMENT_MODE=mock

# Stripe (required only when PAYMENT_MODE=stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Paymob Intention API (required only when PAYMENT_MODE=paymob)
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_PAYMENT_METHOD_IDS=
PAYMOB_NOTIFICATION_URL=
PAYMOB_REDIRECTION_URL=

STORAGE_MODE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional development-only admin creation during `npm run db:seed`
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Password reset delivery — configure a verified sender in Resend.
# Never use NEXT_PUBLIC_ for email credentials.
RESEND_API_KEY=
MAIL_PROVIDER=resend
# Gmail alternative without a domain: switch MAIL_PROVIDER to smtp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_FROM=
PASSWORD_RESET_ORIGIN=http://127.0.0.1:3100

# Optional shared demo shortcut. Hosted mode requires a dedicated altura_demo database.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_MODE=local
CUSTOMER_SEED_EMAIL=
CUSTOMER_SEED_PASSWORD=
