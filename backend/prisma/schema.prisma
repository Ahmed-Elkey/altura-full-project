generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAYMENT_REVIEW
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderAddressType {
  SHIPPING
  BILLING
}

enum PaymentProvider {
  MOCK
  STRIPE
  PAYMOB
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  CLOSED
}

enum NewsletterStatus {
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
}

enum InventoryReason {
  RESTOCK
  PURCHASE
  CANCELLATION
  RETURN
  MANUAL_ADJUSTMENT
  DAMAGE
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  phone           String?
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  authVersion     Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  addresses         Address[]
  refreshTokens     RefreshToken[]
  carts             Cart[]
  wishlist          Wishlist?
  orders            Order[]
  discountUsages    DiscountUsage[]
  returnRequests    ReturnRequest[]
  auditLogs         AuditLog[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  supportAdminReads SupportAdminRead[]

  @@index([role, status])
  @@index([createdAt])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?
  revokedByIp String?
  userAgent   String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt, revokedAt])
}

model Address {
  id                String   @id @default(cuid())
  userId            String
  label             String?
  recipientName     String
  phone             String?
  line1             String
  line2             String?
  city              String
  region            String?
  postalCode        String?
  countryCode       String   @db.VarChar(2)
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([countryCode])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId, position])
}

model Collection {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  status       ProductStatus @default(DRAFT)
  heroImageUrl String?
  position     Int           @default(0)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  products ProductCollection[]

  @@index([status, position])
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String?
  description      String
  status           ProductStatus @default(DRAFT)
  basePrice        Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  currency         String        @default("EGP") @db.VarChar(3)
  materials        Json?
  careInstructions Json?
  details          Json?
  fit              String?
  seoTitle         String?
  seoDescription   String?
  publishedAt      DateTime?
  position         Int           @default(0)
  featured         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  variants      ProductVariant[]
  images        ProductImage[]
  categories    ProductCategory[]
  collections   ProductCollection[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([status, publishedAt])
  @@index([status, featured, position])
  @@index([status, basePrice])
  @@index([name])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  title          String?
  colorName      String
  colorHex       String?
  size           String
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  currency       String   @default("EGP") @db.VarChar(3)
  weightGrams    Int?
  position       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  inventory      Inventory?
  inventoryMoves InventoryMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@unique([productId, colorName, size])
  @@index([productId, active, position])
  @@index([colorName, size])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  colorName String?
  url       String
  altText   String?
  view      String?
  isPrimary Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([productId, url])
  @@index([productId, position])
  @@index([productId, colorName, position])
  @@index([variantId, position])
}

model ProductCategory {
  productId  String
  categoryId String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

model Inventory {
  id                String   @id @default(cuid())
  variantId         String   @unique
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id          String          @id @default(cuid())
  variantId   String
  reason      InventoryReason
  quantity    Int
  referenceId String?
  note        String?
  createdAt   DateTime        @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([referenceId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?    @unique
  status    CartStatus @default(ACTIVE)
  currency  String     @default("EGP") @db.VarChar(3)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         CartItem[]
  sourcedOrders Order[]    @relation("OrderSourceCart")

  @@index([userId, status])
  @@index([status, expiresAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        String    @id @default(cuid())
  userId    String?   @unique
  sessionId String?   @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([expiresAt])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId, createdAt])
  @@index([productId])
}

model Order {
  id                     String      @id @default(cuid())
  orderNumber            String      @unique
  idempotencyKey         String?     @unique
  idempotencyFingerprint String?
  sourceCartId           String?
  sourceCart             Cart?       @relation("OrderSourceCart", fields: [sourceCartId], references: [id], onDelete: SetNull)
  userId                 String?
  email                  String
  phone                  String?
  status                 OrderStatus @default(PENDING)
  currency               String      @default("EGP") @db.VarChar(3)
  subtotal               Decimal     @db.Decimal(12, 2)
  discountTotal          Decimal     @default(0) @db.Decimal(12, 2)
  shippingTotal          Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal               Decimal     @default(0) @db.Decimal(12, 2)
  grandTotal             Decimal     @db.Decimal(12, 2)
  appliedCode            String?
  customerNote           String?
  internalNote           String?
  placedAt               DateTime?
  reservationExpiresAt   DateTime?
  inventoryCommittedAt   DateTime?
  inventoryReleasedAt    DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  addresses      OrderAddress[]
  payments       Payment[]
  webhookEvents  PaymentWebhookEvent[]
  shipments      Shipment[]
  returns        ReturnRequest[]
  discountUsages DiscountUsage[]

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
  @@index([sourceCartId])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String?
  variantId           String?
  sku                 String
  productName         String
  variantName         String?
  colorName           String?
  size                String?
  productImageUrl     String?
  unitPrice           Decimal  @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal  @db.Decimal(12, 2)
  promotionAllocation Json?
  createdAt           DateTime @default(now())

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
  @@index([sku])
}

model OrderAddress {
  id            String           @id @default(cuid())
  orderId       String
  type          OrderAddressType
  recipientName String
  phone         String?
  line1         String
  line2         String?
  city          String
  region        String?
  postalCode    String?
  countryCode   String           @db.VarChar(2)
  createdAt     DateTime         @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, type])
}

model Payment {
  id                     String          @id @default(cuid())
  orderId                String
  provider               PaymentProvider
  status                 PaymentStatus   @default(PENDING)
  idempotencyKey         String          @unique
  idempotencyFingerprint String
  activeAttemptKey       String?         @unique
  providerInitStartedAt  DateTime?
  providerPaymentId      String?         @unique
  providerOrderId        String?
  providerTransactionId  String?
  checkoutSecret         String?
  amount                 Decimal         @db.Decimal(12, 2)
  refundedAmount         Decimal         @default(0) @db.Decimal(12, 2)
  currency               String          @db.VarChar(3)
  failureReason          String?
  metadata               Json?
  paidAt                 DateTime?
  refundedAt             DateTime?
  lastWebhookAt          DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvents PaymentWebhookEvent[]

  @@index([orderId, status])
  @@index([provider, status])
  @@index([provider, providerOrderId])
  @@index([provider, providerTransactionId])
}

model PaymentWebhookEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  externalEventId String
  eventType       String
  paymentId       String?
  orderId         String?
  payload         Json
  processingError String?
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([paymentId, createdAt])
  @@index([orderId, createdAt])
  @@index([processedAt])
}

model Shipment {
  id               String         @id @default(cuid())
  orderId          String
  status           ShipmentStatus @default(PENDING)
  carrier          String?
  shippingMethodId String?
  service          String?
  // Historical snapshot of the shipping cost at purchase time (auditable even if method prices change).
  priceSnapshot    Decimal?       @db.Decimal(12, 2)
  currencySnapshot String?        @db.VarChar(3)
  trackingNumber   String?
  trackingUrl      String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([trackingNumber])
}

model Discount {
  id               String       @id @default(cuid())
  code             String       @unique
  type             DiscountType
  value            Decimal      @db.Decimal(12, 2)
  currency         String?      @db.VarChar(3)
  minimumSubtotal  Decimal?     @db.Decimal(12, 2)
  offerSnapshot    Json?
  maximumDiscount  Decimal?     @db.Decimal(12, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  usages               DiscountUsage[]
  newsletterSubscriber NewsletterSubscriber?

  @@index([active, startsAt, endsAt])
}

model DiscountUsage {
  id         String   @id @default(cuid())
  discountId String
  orderId    String
  userId     String?
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([discountId, orderId])
  @@index([userId, discountId])
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  countries String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  methods ShippingMethod[]
}

model ShippingMethod {
  id               String   @id @default(cuid())
  zoneId           String
  name             String
  code             String
  price            Decimal  @db.Decimal(12, 2)
  currency         String   @default("EGP") @db.VarChar(3)
  freeAbove        Decimal? @db.Decimal(12, 2)
  estimatedMinDays Int?
  estimatedMaxDays Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  shipments Shipment[]

  @@unique([zoneId, code])
  @@index([zoneId, active])
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  userId       String?
  status       ReturnStatus @default(REQUESTED)
  reason       String
  notes        String?
  refundAmount Decimal?     @db.Decimal(12, 2)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items ReturnItem[]

  @@index([orderId, status])
  @@index([userId, createdAt])
}

model ReturnItem {
  id          String   @id @default(cuid())
  returnId    String
  orderItemId String
  quantity    Int
  reason      String?
  condition   String?
  createdAt   DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
}

model NewsletterSubscriber {
  id                 String           @id @default(cuid())
  email              String           @unique
  status             NewsletterStatus @default(SUBSCRIBED)
  subscribedAt       DateTime         @default(now())
  unsubscribedAt     DateTime?
  source             String?
  confirmedAt        DateTime?
  rewardIssuedAt     DateTime?
  offerSnapshot      Json?
  rewardDiscountId   String?          @unique
  rewardDiscount     Discount?        @relation(fields: [rewardDiscountId], references: [id], onDelete: SetNull)
  welcomeStatus      String           @default("PENDING")
  welcomeSentAt      DateTime?
  welcomeAttemptedAt DateTime?
  tokenVersion       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model NewsletterOffer {
  id        String   @id @default("newsletter")
  version   Int      @default(1)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SupportTicketStatus {
  OPEN
  AWAITING_CUSTOMER
  RESOLVED
}

enum SupportAuthorType {
  CUSTOMER
  ADMIN
}

enum SupportAccessKind {
  LINK
  SESSION
}

enum SupportDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model SupportTicket {
  id                   String                 @id @default(cuid())
  reference            String                 @unique
  ownerUserId          String?
  name                 String                 @db.VarChar(120)
  email                String                 @db.VarChar(254)
  subject              String                 @db.VarChar(160)
  orderReference       String?                @db.VarChar(80)
  status               SupportTicketStatus    @default(OPEN)
  creationKey          String                 @unique
  creationFingerprint  String
  version              Int                    @default(0)
  lastSequence         Int                    @default(1)
  lastCustomerSequence Int                    @default(1)
  lastAdminSequence    Int                    @default(0)
  customerReadSequence Int                    @default(1)
  lastMessageAt        DateTime               @default(now())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  owner                User?                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  messages             SupportMessage[]
  guestAccess          SupportGuestAccess[]
  deliveries           SupportEmailDelivery[]
  adminReads           SupportAdminRead[]

  @@index([ownerUserId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
}

model SupportMessage {
  id            String                 @id @default(cuid())
  ticketId      String
  authorType    SupportAuthorType
  actorUserId   String?
  body          String                 @db.VarChar(5000)
  submissionKey String
  ticketVersion Int                    @default(0)
  sequence      Int
  createdAt     DateTime               @default(now())
  ticket        SupportTicket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor         User?                  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  deliveries    SupportEmailDelivery[]

  @@unique([ticketId, submissionKey])
  @@unique([ticketId, sequence])
}

model SupportGuestAccess {
  id        String            @id @default(cuid())
  ticketId  String
  tokenHash String            @unique
  kind      SupportAccessKind
  expiresAt DateTime
  createdAt DateTime          @default(now())
  ticket    SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, kind, expiresAt])
  @@index([expiresAt])
}

model SupportAdminRead {
  id           String        @id @default(cuid())
  ticketId     String
  userId       String
  readSequence Int
  unread       Boolean       @default(false)
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([userId, unread])
}

model SupportEmailDelivery {
  id               String                @id @default(cuid())
  ticketId         String
  messageId        String?
  recipient        String                @db.VarChar(254)
  payloadEncrypted String
  status           SupportDeliveryStatus @default(PENDING)
  attempts         Int                   @default(0)
  nextAttemptAt    DateTime              @default(now())
  leaseId          String?
  leaseExpiresAt   DateTime?
  sentAt           DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  ticket           SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message          SupportMessage?       @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([ticketId, createdAt])
}
