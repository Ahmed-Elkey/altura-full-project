# ALTURA local development configuration
STOREFRONT_MODE=local

# Production integrations are intentionally NOT connected in this package.
# Keep these empty until the user explicitly decides to connect a provider.
# NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# Public URLs are embedded by Next.js at build time; rebuild after changing them.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
